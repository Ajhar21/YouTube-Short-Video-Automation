      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst plan = b && b.plan;\nif (!plan || !Array.isArray(plan.scenes) || plan.scenes.length < 1 || plan.scenes.length > 6) {\n  throw new Error('Invalid plan: expected 1-6 scenes. Got: ' + JSON.stringify(b).slice(0, 500));\n}\nreturn [{ json: {\n  run_id: String(b.run_id),\n  title: plan.title,\n  description: plan.description,\n  tags: plan.tags || [],\n  voiceover: plan.scenes.map(s => s.narration).join(' '),\n  scenes: plan.scenes\n}}];"
      },
